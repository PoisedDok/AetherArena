#!/bin/bash

# Aether Hub - Robust Production Launcher
# Redirect everything to log file immediately

LOG_DIR="$HOME/Library/Logs/aether-desktop"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/backend.log"

# Start logging
echo "--- Launcher Started $(date) ---" >> "$LOG_FILE"

{
    SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
    RESOURCES_DIR="$SCRIPT_DIR/../.."
    BACKEND_DIR="$RESOURCES_DIR/backend"
    
    echo "SCRIPT_DIR: $SCRIPT_DIR"
    echo "RESOURCES_DIR: $RESOURCES_DIR"
    
    # Resolve Python
    VENV_PYTHON="$RESOURCES_DIR/portable-venv/python-bin/python3"
    if [ ! -f "$VENV_PYTHON" ]; then
        VENV_PYTHON="$RESOURCES_DIR/portable-venv/bin/python3"
    fi
    
    echo "PYTHON: $VENV_PYTHON"
    
    if [ ! -f "$VENV_PYTHON" ]; then
        echo "ERROR: Python not found"
        exit 1
    fi
    
    cd "$BACKEND_DIR"
    echo "Entering $BACKEND_DIR"
    
    # Launch Python
    exec "$VENV_PYTHON" main.py "$@"
    
} >> "$LOG_FILE" 2>&1
