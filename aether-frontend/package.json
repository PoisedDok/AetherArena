{
  "name": "aether-desktop",
  "version": "2.0.0",
  "description": "Aether - AI Desktop Assistant (Clean Architecture Rebuild)",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "start": "electron .",
    "dev": "npm run build:all && cross-env ELECTRON_DEV=true GURU_SPAWN_BACKEND=false SKIP_HEALTH_CHECK=true NODE_ENV=development electron .",
    "dev:watch": "npm run build:all:watch & cross-env ELECTRON_DEV=true GURU_SPAWN_BACKEND=false SKIP_HEALTH_CHECK=true NODE_ENV=development electron .",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "playwright test",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:security": "jest tests/integration/security --verbose",
    "test:performance": "jest tests/integration/performance --verbose",
    "build:preload": "node scripts/bundle-preload.mjs",
    "build:preload:watch": "node scripts/bundle-preload.mjs --watch",
    "build:renderer": "node scripts/bundle-renderers.mjs",
    "build:renderer:watch": "node scripts/bundle-renderers.mjs --watch",
    "build:all": "npm run build:preload && npm run build:renderer",
    "build:all:watch": "npm run build:preload:watch & npm run build:renderer:watch",
    "build": "npm run build:all && electron-builder --publish=never",
    "build:mac": "npm run build:all && electron-builder --mac --publish=never",
    "build:mac:full": "npm run build:all && electron-builder --mac --publish=never",
    "build:win": "npm run build:all && electron-builder --win --publish=never",
    "build:linux": "npm run build:all && electron-builder --linux --publish=never",
    "dist": "npm run build",
    "dist:mac": "npm run build:mac",
    "dist:win": "npm run build:win",
    "dist:linux": "npm run build:linux",
    "generate:notices": "node scripts/generate-notices.js",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "security:audit": "node scripts/security-audit.js --verbose",
    "security:audit:fix": "node scripts/security-audit.js --fix",
    "security:audit:json": "node scripts/security-audit.js --json",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix",
    "test:mutation": "stryker run",
    "test:mutation:html": "stryker run --htmlReporter"
  },
  "keywords": [
    "AI",
    "voice",
    "assistant",
    "visualization",
    "clean-architecture"
  ],
  "author": "Krish Dokania",
  "license": "BUSL-1.1",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@supabase/supabase-js": "^2.39.3",
    "ace-builds": "^1.43.2",
    "canvas": "3.2.1",
    "dompurify": "^3.3.0",
    "dotenv": "^16.0.3",
    "events": "^3.3.0",
    "highlight.js": "^11.11.1",
    "marked": "^16.2.1",
    "morphdom": "^2.7.8",
    "pdfjs-dist": "^3.11.174",
    "preact": "^10.28.2",
    "prettier": "^2.8.8",
    "three": "^0.160.0",
    "uuid": "^9.0.0",
    "ws": "^8.13.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/electron": "^1.4.38",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.9.2",
    "cross-env": "^7.0.3",
    "electron": "^39.2.1",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.27.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "json-formatter-js": "^2.5.23",
    "license-checker": "^25.0.1",
    "shiki": "^3.12.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "js-yaml": "^4.1.1",
    "config-file-ts": {
      ".": "^0.2.6",
      "glob": "^11.0.4"
    },
    "canvas": "3.2.1"
  },
  "build": {
    "appId": "xyz.aetherinc.aetherarena",
    "productName": "AetherArena",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "**/*",
      "build/**",
      "!tests/**",
      "!test-results/**",
      "!**/*.md",
      "!.vscode/**",
      "!.github/**",
      "!.architecture/**",
      "!scripts/**",
      "!.env",
      "!.env.*",
      "!jest.config.js",
      "!playwright.config.js",
      "!architecture_index.json"
    ],
    "extraResources": [
      {
        "from": "../aether-backend/dist/aether-hub",
        "to": "bin/aether-hub"
      },
      {
        "from": "../aether-backend/start_production.sh",
        "to": "bin/start_production.sh"
      },
      {
        "from": "../aether-backend/stop_backend.sh",
        "to": "bin/stop_backend.sh"
      },
      {
        "from": "../aether-backend/core/system/setup_engine.py",
        "to": "bin/core/system/setup_engine.py"
      },
      {
        "from": "../aether-backend/scripts/requirements_oi_server.txt",
        "to": "bin/scripts/requirements_oi_server.txt"
      },
      {
        "from": "../aether-backend/services/aether_inference",
        "to": "bin/services/aether_inference",
        "filter": [
          "server.py",
          "!__pycache__/**",
          "!*.pyc"
        ]
      },
      {
        "from": "../aether-backend/config",
        "to": "bin/config",
        "filter": [
          "**/*",
          "!local.env",
          "!.env",
          "!.env.*",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../aether-backend/services/external-services",
        "to": "bin/services/external-services",
        "filter": [
          "**/*",
          "!**/volumes/db/data/**",
          "!**/volumes/storage/**",
          "!**/*.env",
          "!**/*.env.*"
        ]
      },
      {
        "from": "../aether-backend/services/perplexica",
        "to": "bin/services/perplexica",
        "filter": [
          "**/*",
          "!node_modules/**",
          "!.next/**",
          "!**/volumes/**/data/**",
          "!**/*.env",
          "!**/*.env.*"
        ]
      },
      {
        "from": "../aether-backend/data/database/migrations",
        "to": "bin/data/database/migrations"
      },
      {
        "from": "resources/launcher",
        "to": "launcher"
      },
      {
        "from": "../THIRD-PARTY-NOTICES",
        "to": "THIRD-PARTY-NOTICES"
      }
    ],
    "afterPack": "./scripts/afterPack.js",
    "mac": {
      "category": "public.app-category.productivity",
      "target": {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      },
      "icon": "assets/icons/icon.icns"
    },
    "dmg": {
      "backgroundColor": "#1a1a2e",
      "icon": "assets/icons/icon.icns",
      "iconSize": 100,
      "title": "AetherArena",
      "format": "UDZO",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      "icon": "assets/icons/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
