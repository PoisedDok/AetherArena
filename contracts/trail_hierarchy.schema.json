{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether/contracts/trail_hierarchy.schema.json",
  "title": "Aether Trail Hierarchy",
  "description": "Defines the hierarchical trail structure: Groups → Subgroups → Nodes → Artifacts (array response)",
  "definitions": {
    "node": {
      "type": "object",
      "required": ["node_id", "type", "status", "sequence", "clickable"],
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$",
          "description": "Node UUID"
        },
        "type": {
          "type": "string",
          "enum": ["writing", "executing", "output"],
          "description": "Node type in execution pipeline"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "active", "completed", "error"],
          "description": "Node execution status"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "Node position in subgroup (1=writing, 2=executing, 3=output)"
        },
        "clickable": {
          "type": "boolean",
          "description": "Whether node is clickable in UI"
        },
        "artifact_id": {
          "type": ["string", "null"],
          "description": "REQUIRED when status=completed. Stable artifact ID from stream_service.py"
        },
        "artifact_type": {
          "type": ["string", "null"],
          "enum": ["code", "output", null],
          "description": "Type of linked artifact: code (assistant writes) or output (computer produces). Null if no artifact."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Node creation timestamp"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Node last update timestamp"
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "description": "Node start timestamp"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time",
          "description": "Node completion timestamp"
        },
        "duration_ms": {
          "type": "integer",
          "description": "Execution duration in milliseconds"
        }
      },
      "additionalProperties": false
    },
    "subgroup": {
      "type": "object",
      "required": ["id", "group_id", "sequence_number", "sequence_in_chat", "status", "nodes"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$",
          "description": "Subgroup UUID"
        },
        "group_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$",
          "description": "Parent group UUID"
        },
        "sequence_number": {
          "type": "integer",
          "minimum": 1,
          "description": "Execution order within group (1-indexed)"
        },
        "subgroup_sequence": {
          "type": "integer",
          "minimum": 1,
          "description": "Alias for subgroup sequence (frontend compatibility)"
        },
        "sequence_in_chat": {
          "type": "integer",
          "minimum": 1,
          "description": "Timeline position for ordering in chat"
        },
        "execution_group": {
          "type": "string",
          "description": "Execution group identifier (request_id)"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "running", "completed", "error"],
          "description": "Aggregated status from nodes"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "display_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "chat_id_cache": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$"
        },
        "nodes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/definitions/node" },
          "description": "ALWAYS exactly 3 nodes: [writing, executing, output]"
        }
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "required": ["id", "chat_id", "user_message", "agent_message", "sequence_number", "subgroups"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$",
          "description": "Group UUID"
        },
        "chat_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$",
          "description": "Chat UUID"
        },
        "sequence_number": {
          "type": "integer",
          "minimum": 1,
          "description": "User turn number in chat (1-indexed)"
        },
        "user_message": {
          "type": "string",
          "minLength": 1,
          "description": "User message text for DOM anchor matching"
        },
        "agent_message": {
          "type": "string",
          "minLength": 1,
          "description": "Agent response text (required by groups table)"
        },
        "frontend_id": {
          "type": "string"
        },
        "backend_id": {
          "type": "string"
        },
        "correlation_id": {
          "type": "string"
        },
        "user_message_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$"
        },
        "agent_message_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "subgroups": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/subgroup" },
          "description": "MULTIPLE SUBGROUPS PER GROUP: One subgroup per code execution. If agent runs code 3 times in same turn, create 3 subgroups. Each subgroup = 1 trail container in UI."
        }
      },
      "additionalProperties": false
    }
  },
  "type": "array",
  "items": { "$ref": "#/definitions/group" },
  "description": "Ordered list of group records with nested subgroups and nodes"
}

