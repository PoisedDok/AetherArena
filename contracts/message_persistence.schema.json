{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether/contracts/message_persistence.schema.json",
  "title": "Aether Message Persistence",
  "description": "Defines message persistence contract for user and assistant messages",
  "definitions": {
    "user_message": {
      "type": "object",
      "required": ["role", "content", "chat_id"],
      "properties": {
        "role": {
          "type": "string",
          "const": "user"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "description": "User message text"
        },
        "chat_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$"
        },
        "correlation_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$",
          "description": "Request correlation ID for trail linkage"
        },
        "metadata": {
          "type": ["object", "null"]
        }
      },
      "additionalProperties": false
    },
    "assistant_message": {
      "type": "object",
      "required": ["role", "content", "chat_id", "correlation_id"],
      "properties": {
        "role": {
          "type": "string",
          "const": "assistant"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "description": "Assistant message text"
        },
        "chat_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$"
        },
        "correlation_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$",
          "description": "REQUIRED: Links message to trail group"
        },
        "metadata": {
          "type": ["object", "null"]
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/user_message" },
    { "$ref": "#/definitions/assistant_message" }
  ]
}

