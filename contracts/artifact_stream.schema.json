{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether/contracts/artifact_stream.schema.json",
  "title": "Aether Artifact Stream Event",
  "description": "Defines artifact streaming payloads from backend to frontend (snake_case fields).",
  "definitions": {
    "stream_chunk": {
      "type": "object",
      "required": ["artifact_id", "request_id", "role", "type", "chat_id", "timestamp"],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable artifact ID generated by backend (format: {backend_id}:{type}:{counter})."
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$",
          "description": "Backend request identifier"
        },
        "role": {
          "type": "string",
          "enum": ["assistant", "computer"],
          "description": "Artifact producer role"
        },
        "type": {
          "type": "string",
          "enum": ["code", "output"],
          "description": "Only 2 artifact types exist. Format is specified via format/language."
        },
        "format": {
          "type": "string",
          "description": "Language (code) or rendering format (output). Examples: python, html, json, console, text"
        },
        "language": {
          "type": "string",
          "description": "Alias for format field"
        },
        "content": {
          "type": "string",
          "description": "Artifact content chunk"
        },
        "chat_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$",
          "description": "Chat UUID"
        },
        "message_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$",
          "description": "Message UUID (set after persistence)"
        },
        "correlation_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$",
          "description": "Request correlation ID"
        },
        "execution_group": {
          "type": "string",
          "description": "Execution group identifier (usually request_id)"
        },
        "node_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$"
        },
        "subgroup_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$"
        },
        "recipient": {
          "type": "string",
          "description": "Optional recipient routing hint (e.g. assistant)"
        },
        "start": {
          "type": "boolean",
          "default": false
        },
        "end": {
          "type": "boolean",
          "default": false
        },
        "timestamp": {
          "type": ["number", "string"],
          "description": "Unix timestamp (ms) or ISO string"
        },
        "metadata": {
          "type": "object",
          "description": "Additional metadata"
        }
      },
      "additionalProperties": false
    },
    "stream_marker": {
      "type": "object",
      "required": ["request_id", "role", "type", "chat_id", "timestamp"],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "description": "May be absent on early start/end markers"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$",
          "description": "Backend request identifier"
        },
        "role": {
          "type": "string",
          "enum": ["assistant", "computer"],
          "description": "Artifact producer role"
        },
        "type": {
          "type": "string",
          "enum": ["code", "output"],
          "description": "Only 2 artifact types exist"
        },
        "format": { "type": "string" },
        "language": { "type": "string" },
        "chat_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$",
          "description": "Chat UUID"
        },
        "message_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$"
        },
        "correlation_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$"
        },
        "execution_group": { "type": "string" },
        "node_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$"
        },
        "subgroup_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$"
        },
        "recipient": { "type": "string" },
        "start": {
          "type": "boolean",
          "default": false
        },
        "end": {
          "type": "boolean",
          "default": false
        },
        "timestamp": {
          "type": ["number", "string"],
          "description": "Unix timestamp (ms) or ISO string"
        },
        "metadata": {
          "type": "object",
          "description": "Additional metadata"
        }
      },
      "anyOf": [
        { "required": ["start"] },
        { "required": ["end"] }
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/stream_chunk" },
    { "$ref": "#/definitions/stream_marker" }
  ]
}


