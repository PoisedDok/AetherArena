{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "chat_session_map.schema.json",
  "title": "Chat Session Map Schema",
  "description": "Complete linear timeline of all events in a chat session for restoration, context recovery, and cross-chat reasoning",
  "version": "1.0.0",
  
  "definitions": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    
    "message_event": {
      "type": "object",
      "required": ["type", "sequence", "timestamp", "role", "message_id", "content"],
      "properties": {
        "type": { "const": "message" },
        "sequence": { "type": "integer", "minimum": 1 },
        "timestamp": { "$ref": "#/definitions/timestamp" },
        "role": { "enum": ["user", "assistant"] },
        "message_id": { "$ref": "#/definitions/uuid" },
        "content": { "type": "string" },
        "model": { "type": "string" },
        "tokens": {
          "type": "object",
          "properties": {
            "input": { "type": "integer" },
            "output": { "type": "integer" }
          }
        }
      }
    },
    
    "artifact_event": {
      "type": "object",
      "required": ["type", "sequence", "timestamp", "artifact_id", "artifact_type", "trail_context"],
      "properties": {
        "type": { "const": "artifact" },
        "sequence": { "type": "integer", "minimum": 1 },
        "timestamp": { "$ref": "#/definitions/timestamp" },
        "artifact_id": { "type": "string" },
        "artifact_type": { "enum": ["code", "output"] },
        "execution_group": { "type": "string" },
        "language": { "type": "string" },
        "content": { "type": "string" },
        "duration_ms": { "type": "integer" },
        "trail_context": {
          "type": "object",
          "required": ["group_id", "subgroup_id", "node_id"],
          "properties": {
            "group_id": { "$ref": "#/definitions/uuid" },
            "group_sequence": { "type": "integer" },
            "subgroup_id": { "$ref": "#/definitions/uuid" },
            "subgroup_sequence": { "type": "integer" },
            "node_id": { "$ref": "#/definitions/uuid" },
            "node_type": { "enum": ["writing", "executing", "output"] }
          }
        }
      }
    },
    
    "file_event": {
      "type": "object",
      "required": ["type", "sequence", "timestamp", "file_id", "file_name", "action"],
      "properties": {
        "type": { "const": "file" },
        "sequence": { "type": "integer", "minimum": 1 },
        "timestamp": { "$ref": "#/definitions/timestamp" },
        "file_id": { "$ref": "#/definitions/uuid" },
        "file_name": { "type": "string" },
        "file_path": { "type": "string" },
        "file_size": { "type": "integer" },
        "mime_type": { "type": "string" },
        "action": { "enum": ["uploaded", "referenced", "generated", "modified", "deleted"] },
        "related_message_id": { "$ref": "#/definitions/uuid" }
      }
    },
    
    "trail_event": {
      "type": "object",
      "required": ["type", "sequence", "timestamp", "group_id", "subgroup_id"],
      "properties": {
        "type": { "const": "trail" },
        "sequence": { "type": "integer", "minimum": 1 },
        "timestamp": { "$ref": "#/definitions/timestamp" },
        "group_id": { "$ref": "#/definitions/uuid" },
        "group_sequence": { "type": "integer" },
        "subgroup_id": { "$ref": "#/definitions/uuid" },
        "subgroup_sequence": { "type": "integer" },
        "execution_group": { "type": "string" },
        "status": { "enum": ["pending", "active", "completed", "error"] },
        "duration_ms": { "type": "integer" },
        "nodes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["node_id", "type", "status"],
            "properties": {
              "node_id": { "$ref": "#/definitions/uuid" },
              "type": { "enum": ["writing", "executing", "output"] },
              "status": { "enum": ["pending", "active", "completed", "error"] },
              "artifact_id": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    
    "context_event": {
      "type": "object",
      "required": ["type", "sequence", "timestamp", "context_type"],
      "properties": {
        "type": { "const": "context" },
        "sequence": { "type": "integer", "minimum": 1 },
        "timestamp": { "$ref": "#/definitions/timestamp" },
        "context_type": { "enum": ["web_search", "tool_call", "memory_recall", "document_reference"] },
        "source": { "type": "string" },
        "data": { "type": "object" },
        "related_message_id": { "$ref": "#/definitions/uuid" }
      }
    }
  },
  
  "type": "object",
  "required": ["chat_id", "created_at", "updated_at", "timeline"],
  "properties": {
    "chat_id": { "$ref": "#/definitions/uuid" },
    "title": { "type": "string" },
    "created_at": { "$ref": "#/definitions/timestamp" },
    "updated_at": { "$ref": "#/definitions/timestamp" },
    "user_id": { "$ref": "#/definitions/uuid" },
    
    "metadata": {
      "type": "object",
      "properties": {
        "total_messages": { "type": "integer" },
        "total_artifacts": { "type": "integer" },
        "total_files": { "type": "integer" },
        "total_trails": { "type": "integer" },
        "total_tokens": { "type": "integer" },
        "duration_seconds": { "type": "integer" },
        "models_used": { "type": "array", "items": { "type": "string" } }
      }
    },
    
    "timeline": {
      "type": "array",
      "description": "Complete linear timeline of all events in perfect chronological order",
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/message_event" },
          { "$ref": "#/definitions/artifact_event" },
          { "$ref": "#/definitions/file_event" },
          { "$ref": "#/definitions/trail_event" },
          { "$ref": "#/definitions/context_event" }
        ]
      }
    },
    
    "indexes": {
      "type": "object",
      "description": "Quick lookup indexes for efficient restoration",
      "properties": {
        "messages_by_id": { "type": "object" },
        "artifacts_by_id": { "type": "object" },
        "trails_by_group": { "type": "object" },
        "files_by_id": { "type": "object" }
      }
    }
  },
  
  "additionalProperties": false
}

