{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether/contracts/artifact_persistence.schema.json",
  "title": "Aether Artifact Persistence",
  "description": "Defines artifact persistence request from frontend to backend. Trail linkage required for output artifacts only.",
  "type": "object",
  "required": ["artifact_id", "type", "content", "chat_id"],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "description": "REQUIRED: Stable artifact ID from stream (backend-generated)"
    },
    "type": {
      "type": "string",
      "enum": ["code", "output", "file"],
      "description": "Artifact type: code (assistant writes), output (computer produces), file (user uploads)"
    },
    "content": {
      "type": "string",
      "minLength": 0,
      "description": "Artifact content (may be empty for placeholder artifacts)"
    },
    "chat_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$",
      "description": "Chat UUID"
    },
    "message_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F-]{36}$",
      "description": "Message UUID (null for in-progress artifacts)"
    },
    "node_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F-]{36}$",
      "description": "Trail node ID from trail.artifact_linked event. REQUIRED for output artifacts, optional for code/file."
    },
    "subgroup_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F-]{36}$",
      "description": "Trail subgroup ID from trail.artifact_linked event. REQUIRED for output artifacts, optional for code/file."
    },
    "filename": {
      "type": ["string", "null"],
      "description": "Filename for code/file artifacts"
    },
    "language": {
      "type": ["string", "null"],
      "description": "Programming language for code artifacts"
    },
    "metadata": {
      "type": ["object", "null"],
      "description": "Additional metadata"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": { "const": "output" }
        }
      },
      "then": {
        "required": ["node_id", "subgroup_id"],
        "properties": {
          "node_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F-]{36}$"
          },
          "subgroup_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F-]{36}$"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}

