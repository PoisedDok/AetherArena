[run]
source = .
omit =
    # Vendored libraries (not our code)
    services/xlwings/*
    services/docling/*
    services/aether-rag/*
    services/realtime-tts/*
    # Hardware-dependent integration wrappers (require external software;
    # belong in integration tests, not unit tests)
    core/integrations/libraries/xlwings/*
    core/integrations/libraries/tts/realtime_tts.py
    core/integrations/libraries/omni/tools.py
    # Process entry points (uvicorn/worker bootstrap; no testable logic)
    main.py
    workers/__main__.py
    # Test files themselves
    tests/*
    # Migrations and scripts
    migrations/*
    scripts/*
    # Virtual environments
    .venv/*
    venv/*
    env/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__
    raise NotImplementedError
    pass
    except ImportError
show_missing = true
precision = 2

[html]
directory = tests/htmlcov
