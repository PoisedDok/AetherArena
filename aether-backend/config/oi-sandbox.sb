(version 1)
(allow default)

;; Prevent Open Interpreter from reading core backend secrets
(deny file-read* (literal (param "LOCAL_ENV_PATH")))

;; Prevent Open Interpreter from reading SSH keys
(deny file-read* (subpath (param "SSH_DIR")))

;; Prevent Open Interpreter from modifying the sandbox profile itself
(deny file-write* (literal (param "SANDBOX_PROFILE_PATH")))