#!/usr/bin/env python3
"""
AetherArena Proactive Daemons Launcher

Single executable that runs all 4 proactive daemons:
- Browser history logging
- Email logging  
- Active windows tracking
- Filesystem event logging

This runs as a named process 'aether-daemons' so you can grant
Full Disk Access to 'AetherArena' instead of 'Python' or 'Cursor'.
"""
import asyncio
import logging
import signal
import sys
import argparse
from pathlib import Path

# Add aether-backend to path
backend_root = Path(__file__).parent.parent.parent.parent
sys.path.insert(0, str(backend_root))

from services.daemons.browser.daemon import BrowserDaemon
from services.daemons.browser.config import BrowserDaemonConfig
from services.daemons.email.daemon import EmailDaemon
from services.daemons.email.config import EmailDaemonConfig
from services.daemons.filesystem.daemon import FileSystemDaemon
from services.daemons.filesystem.config import FileSystemDaemonConfig

logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
)
logger = logging.getLogger("AetherDaemons")


class AetherDaemonsOrchestrator:
    """Orchestrates all 3 proactive source daemons (browser, email, filesystem)."""
    
    def __init__(self, config_flags: dict):
        self.config_flags = config_flags
        self.daemons = []
        self.tasks = []
    
    async def start(self):
        """Start all enabled daemons."""
        logger.info("=" * 80)
        logger.info("🚀 AETHER PROACTIVE DAEMONS STARTING")
        logger.info("=" * 80)
        
        # Load configs and create daemons based on settings
        from config.settings import get_settings
        settings = get_settings()
        proactive = settings.proactive
        
        # 1. Browser Daemon
        if proactive.daemons.browser_enabled and self.config_flags.get('browser', True):
            try:
                config = BrowserDaemonConfig.from_settings()
                daemon = BrowserDaemon(config)
                self.daemons.append(('browser', daemon))
                logger.info("✅ Browser daemon initialized")
            except Exception as e:
                logger.error(f"Failed to init browser daemon: {e}")
        
        # 2. Email Daemon
        if proactive.daemons.email_enabled and self.config_flags.get('email', True):
            try:
                config = EmailDaemonConfig.from_settings()
                daemon = EmailDaemon(config)
                self.daemons.append(('email', daemon))
                logger.info("✅ Email daemon initialized")
            except Exception as e:
                logger.error(f"Failed to init email daemon: {e}")
        
        # 3. Filesystem Daemon
        if proactive.daemons.file_system_enabled and self.config_flags.get('filesystem', True):
            try:
                config = FileSystemDaemonConfig.from_settings()
                daemon = FileSystemDaemon(config)
                self.daemons.append(('filesystem', daemon))
                logger.info("✅ Filesystem daemon initialized")
            except Exception as e:
                logger.error(f"Failed to init filesystem daemon: {e}")
        
        if not self.daemons:
            logger.error("No daemons enabled - check config or flags")
            return
        
        logger.info(f"\n🔥 Starting {len(self.daemons)} daemons...")
        logger.info("=" * 80)
        
        # Start all daemons concurrently
        for name, daemon in self.daemons:
            task = asyncio.create_task(daemon.start(), name=f"daemon_{name}")
            self.tasks.append((name, task))
        
        # Wait for all tasks
        await asyncio.gather(*[task for _, task in self.tasks], return_exceptions=True)
    
    async def stop(self):
        """Stop all daemons gracefully."""
        logger.info("\n🛑 Stopping all daemons...")
        
        for name, daemon in self.daemons:
            try:
                await daemon.stop()
                logger.info(f"✅ Stopped {name} daemon")
            except Exception as e:
                logger.error(f"Error stopping {name}: {e}")
        
        # Cancel tasks
        for name, task in self.tasks:
            if not task.done():
                task.cancel()


async def main():
    """Entry point for AetherArena daemons."""
    parser = argparse.ArgumentParser(
        description="AetherArena Proactive Daemons - All-in-one launcher",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # Start all daemons
  ./aether-daemons
  
  # Start only specific daemons
  ./aether-daemons --browser --filesystem
  
  # Request permissions (opens System Settings)
  ./aether-daemons --request-permissions
        """
    )
    
    parser.add_argument("--browser", action="store_true", help="Enable browser daemon")
    parser.add_argument("--email", action="store_true", help="Enable email daemon")
    parser.add_argument("--windows", action="store_true", help="Enable active windows daemon")
    parser.add_argument("--filesystem", action="store_true", help="Enable filesystem daemon")
    
    args = parser.parse_args()
    
    # Determine which daemons to run
    config_flags = {}
    
    # If no specific flags, run all
    if not any([args.browser, args.email, args.windows, args.filesystem]):
        config_flags = {'browser': True, 'email': True, 'windows': True, 'filesystem': True}
    else:
        config_flags = {
            'browser': args.browser,
            'email': args.email,
            'windows': args.windows,
            'filesystem': args.filesystem
        }
    
    orchestrator = AetherDaemonsOrchestrator(config_flags)
    
    # Setup signal handlers
    loop = asyncio.get_running_loop()
    for sig in (signal.SIGINT, signal.SIGTERM):
        loop.add_signal_handler(sig, lambda: asyncio.create_task(orchestrator.stop()))
    
    try:
        await orchestrator.start()
    except Exception as e:
        logger.error(f"Orchestrator failed: {e}", exc_info=True)
    finally:
        await orchestrator.stop()


if __name__ == "__main__":
    asyncio.run(main())
