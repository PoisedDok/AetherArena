# ============================================================================
# Aether File Indexing Service - systemd Unit File (Linux)
# ============================================================================
# Installation:
#   1. Copy this file to: /etc/systemd/system/aether-file-indexing.service
#   2. Update WorkingDirectory and ExecStart paths
#   3. Update Environment variables (especially SUPABASE credentials)
#   4. Run: sudo systemctl daemon-reload
#   5. Run: sudo systemctl enable aether-file-indexing
#   6. Run: sudo systemctl start aether-file-indexing
#
# Useful Commands:
#   Status:   sudo systemctl status aether-file-indexing
#   Logs:     sudo journalctl -u aether-file-indexing -f
#   Restart:  sudo systemctl restart aether-file-indexing
#   Stop:     sudo systemctl stop aether-file-indexing
#   Disable:  sudo systemctl disable aether-file-indexing

[Unit]
Description=Aether File Indexing Service
Documentation=https://github.com/your-org/aether
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USERNAME
Group=YOUR_GROUP

# Working Directory (UPDATE THIS PATH)
WorkingDirectory=/path/to/AetherArena/aether-backend

# Execution Command (UPDATE PYTHON PATH AND WORKING DIRECTORY)
ExecStart=/usr/bin/python3 -m services.file_indexing.daemon

# Environment Variables
Environment="PYTHONPATH=/path/to/AetherArena/aether-backend"

# Supabase Configuration (REQUIRED - UPDATE THESE)
Environment="SUPABASE_URL=YOUR_SUPABASE_URL"
Environment="SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Embedding Model Configuration
Environment="EMBEDDING_SERVICE_MODEL=BAAI/bge-small-en-v1.5"

# Backend URL for MCP
Environment="INTEGRATION_FILE_INDEXING_BACKEND_URL=http://127.0.0.1:8765"

# Service Configuration (Optional)
Environment="FI_HEARTBEAT_INTERVAL=30"
Environment="FI_SCAN_INTERVAL=60"
Environment="FI_MAX_CONCURRENT=1"
Environment="FI_LOG_LEVEL=INFO"

# Restart Policy
Restart=on-failure
RestartSec=10s
StartLimitInterval=200
StartLimitBurst=5

# Resource Limits
Nice=10
CPUWeight=50
MemoryMax=2G
TasksMax=100

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aether-file-indexing

# Security Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp /path/to/indexed/locations

# Process Management
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

