<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Service Identification -->
    <key>Label</key>
    <string>com.aether.fileindexing</string>
    
    <key>ProgramArguments</key>
    <array>
{{PROGRAM_ARGUMENTS}}
    </array>
    
    <!-- Working Directory -->
    <key>WorkingDirectory</key>
    <string>{{BACKEND_DIR}}</string>
    
    <!-- Environment Variables -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>{{BACKEND_DIR}}</string>

        <key>AETHER_BACKEND_ROOT</key>
        <string>{{AETHER_BACKEND_ROOT}}</string>
        
        <key>SUPABASE_URL</key>
        <string>{{SUPABASE_URL}}</string>
        
        <key>SUPABASE_SERVICE_ROLE_KEY</key>
        <string>{{SUPABASE_SERVICE_ROLE_KEY}}</string>
        
        <!-- Service Configuration (Optional) -->
        <key>FI_HEARTBEAT_INTERVAL</key>
        <string>10</string>
        
        <key>FI_SCAN_INTERVAL</key>
        <string>60</string>
        
        <key>FI_MAX_CONCURRENT</key>
        <string>1</string>
        
        <key>FI_LOG_LEVEL</key>
        <string>INFO</string>
    </dict>
    
    <!-- Execution Settings -->
    <key>RunAtLoad</key>
    <true/>
    
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>
    
    <!-- Restart Settings -->
    <key>ThrottleInterval</key>
    <integer>60</integer>
    
    <key>StartInterval</key>
    <integer>300</integer>
    
    <!-- Logging -->
    <key>StandardOutPath</key>
    <string>{{STDOUT_LOG_PATH}}</string>
    
    <key>StandardErrorPath</key>
    <string>{{STDERR_LOG_PATH}}</string>
    
    <!-- Process Settings -->
    <key>ProcessType</key>
    <string>Background</string>
    
    <key>Nice</key>
    <integer>10</integer>
    
    <key>AbandonProcessGroup</key>
    <true/>
</dict>
</plist>

